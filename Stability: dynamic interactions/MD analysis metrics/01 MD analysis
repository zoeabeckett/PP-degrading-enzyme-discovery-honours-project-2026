HBOND_COLOR = "#2C3E50"

FONT_SIZE  = 11
TITLE_SIZE = 12

# Helpers
def find_candidate_dirs(base_dir):
    """Return sorted list of all candidate_* subdirectories in base_dir."""
    pattern = os.path.join(base_dir, "candidate_*")
    dirs = sorted(d for d in glob.glob(pattern) if os.path.isdir(d))
    if not dirs:
        raise FileNotFoundError(
            f"No directories matching 'candidate_*' found in {base_dir}."
        )
    print(f"Found {len(dirs)} candidate folder(s):")
    for d in dirs:
        print(f"  {os.path.basename(d)}")
    return dirs


def find_holo_files(candidate_dir):
    """Find holo PDB + DCD pair inside a candidate directory."""
    pdb_matches = glob.glob(os.path.join(candidate_dir, "*holo*.pdb"))
    dcd_matches = glob.glob(os.path.join(candidate_dir, "*holo*.dcd"))
    if not pdb_matches or not dcd_matches:
        raise FileNotFoundError(
            f"Could not find holo PDB+DCD in {candidate_dir}\n"
            f"  PDB files found: {pdb_matches}\n"
            f"  DCD files found: {dcd_matches}"
        )
    return pdb_matches[0], dcd_matches[0]


def style_axis(ax, xlabel, ylabel, title):
    ax.set_xlabel(xlabel, fontsize=FONT_SIZE)
    ax.set_ylabel(ylabel, fontsize=FONT_SIZE)
    ax.set_title(title, fontsize=TITLE_SIZE, pad=8)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.yaxis.grid(True, linestyle="--", alpha=0.4)
    ax.set_axisbelow(True)
    ax.tick_params(labelsize=FONT_SIZE - 1)


def save_fig(fig, path):
    fig.tight_layout()
    fig.savefig(path, dpi=150, bbox_inches="tight")
    plt.close(fig)
    print(f"    Saved: {path}")


# Analysis functions 

def run_rmsd(u, out_dir, cname):
    print("    Running RMSD...")
    protein = u.select_atoms("protein and backbone")
    R = rms.RMSD(protein, protein, ref_frame=0)
    R.run()
    results = R.results.rmsd
    times = results[:, 1] / 1000   # ps → ns
    rmsd  = results[:, 2] / 10     # Å → nm

    fig, ax = plt.subplots(figsize=(7, 4))
    ax.plot(times, rmsd, color=RMSD_COLOR, linewidth=0.8, alpha=0.9)
    style_axis(ax, "Time (ns)", "RMSD (nm)", f"{cname} — Backbone RMSD")
    ax.set_ylim(bottom=0)
    save_fig(fig, os.path.join(out_dir, "rmsd.png"))
    pd.DataFrame({"time_ns": times, "rmsd_nm": rmsd}).to_csv(
        os.path.join(out_dir, "rmsd.csv"), index=False)


def run_rg(u, out_dir, cname):
    print("    Running Rg...")
    protein = u.select_atoms("protein")
    rg_vals, times = [], []
    for ts in u.trajectory:
        rg_vals.append(protein.radius_of_gyration() / 10)  # Å → nm
        times.append(ts.time / 1000)                        # ps → ns

    fig, ax = plt.subplots(figsize=(7, 4))
    ax.plot(times, rg_vals, color=RG_COLOR, linewidth=0.8, alpha=0.9)
    style_axis(ax, "Time (ns)", "Rg (nm)", f"{cname} — Radius of Gyration")
    save_fig(fig, os.path.join(out_dir, "rg.png"))
    pd.DataFrame({"time_ns": times, "rg_nm": rg_vals}).to_csv(
        os.path.join(out_dir, "rg.csv"), index=False)


def run_sasa(u, out_dir, cname):
    print("    Running SASA (this may take a few minutes)...")
    try:
        import freesasa
    except ImportError:
        print("    WARNING: freesasa not installed. Run: pip install freesasa")
        print("    Skipping SASA.")
        return

    protein = u.select_atoms("protein")
    sasa, times = [], []

    for ts in u.trajectory:
        times.append(ts.time / 1000)
        structure = freesasa.Structure()
        for i, atom in enumerate(protein):
            structure.addAtom(
                atom.name, atom.resname, str(atom.resid), "A",
                float(protein.positions[i][0]),
                float(protein.positions[i][1]),
                float(protein.positions[i][2])
            )
        result = freesasa.calc(structure)
        sasa.append(result.totalArea() / 100)  # Å² → nm²

    times = np.array(times)
    sasa  = np.array(sasa)

    fig, ax = plt.subplots(figsize=(7, 4))
    ax.plot(times, sasa, color=SASA_COLOR, linewidth=0.8, alpha=0.9)
    style_axis(ax, "Time (ns)", "SASA (nm²)", f"{cname} — Solvent Accessible Surface Area")
    save_fig(fig, os.path.join(out_dir, "sasa.png"))
    pd.DataFrame({"time_ns": times, "sasa_nm2": sasa}).to_csv(
        os.path.join(out_dir, "sasa.csv"), index=False)


