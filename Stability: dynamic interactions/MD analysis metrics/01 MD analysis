# MD analysis pipeline

def process_candidate(candidate_dir, output_dir):
    """Run the full MD analysis pipeline for one candidate folder."""
    cname    = os.path.basename(os.path.normpath(candidate_dir))
    cand_out = os.path.join(output_dir, cname)
    os.makedirs(cand_out, exist_ok=True)

    print(f"\n{'='*55}")
    print(f"Processing: {cname}")
    print(f"{'='*55}")

    try:
        pdb, dcd = find_holo_files(candidate_dir)
    except FileNotFoundError as e:
        print(f"  WARNING: Skipping {cname} — {e}")
        return

    print(f"  Topology  : {os.path.basename(pdb)}")
    print(f"  Trajectory: {os.path.basename(dcd)}")

    u = mda.Universe(pdb, dcd)
    print(f"  Frames: {len(u.trajectory)}  |  Atoms: {len(u.atoms)}")

    # Sanity checks for expected non-protein residues
    for resname, label in [
        (LIGAND_RESNAME,  "Candidate ligand"),
        (OXG_RESNAME,     "FE2 iron cofactor"),
        (OXG_MOL_RESNAME, "2-oxoglutarate"),
    ]:
        sel = u.select_atoms(f"resname {resname}")
        if len(sel) == 0:
            print(f"  WARNING: {label} '{resname}' not found — "
                  f"check configuration at top of script.")
        else:
            print(f"  {label} ({resname}): {len(sel)} atom(s) found")

    lig = u.select_atoms(f"resname {LIGAND_RESNAME}")
    has_ligand = len(lig) > 0

    for name, fn in [
        ("RMSD",  lambda: run_rmsd(u, cand_out, cname)),
        ("Rg",    lambda: run_rg(u, cand_out, cname)),
        ("SASA",  lambda: run_sasa(u, cand_out, cname)),
        ("RMSF",  lambda: run_rmsf(u, cand_out, cname)),
    ]:
        try:
            fn()
        except Exception as e:
            print(f"    ERROR in {name}: {e}")

    print(f"  Done. Outputs in: {cand_out}/")


# Main

def run(base_dir, output_dir, candidate=None):
    os.makedirs(output_dir, exist_ok=True)

    if candidate:
        # Single candidate specified explicitly
        cdir = os.path.join(base_dir, candidate)
        if not os.path.isdir(cdir):
            raise FileNotFoundError(
                f"Specified candidate folder not found: {cdir}"
            )
        candidate_dirs = [cdir]
    else:
        # Discover all candidate_* folders
        candidate_dirs = find_candidate_dirs(base_dir)

    for cdir in candidate_dirs:
        process_candidate(cdir, output_dir)

    print(f"\n{'='*55}")
    print(f"All candidates complete. Outputs in: {output_dir}/")
    print(f"{'='*55}")



if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="MD analysis (RMSD, Rg, SASA, RMSF) for 2OG candidates"
    )
    parser.add_argument(
        "--base_dir", required=True,
        help="Path to parent folder containing candidate_* subdirectories"
    )
    parser.add_argument(
        "--candidate", default=None,
        help="Optional: process a single named candidate (e.g. candidate_AA). "
             "If omitted, all candidate_* folders are processed."
    )
    parser.add_argument(
        "--output_dir", default="md_analysis_output",
    )
    args = parser.parse_args()

    run(base_dir=args.base_dir, output_dir=args.output_dir, candidate=args.candidate)
