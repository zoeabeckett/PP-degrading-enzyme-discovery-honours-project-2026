import huggingface_hub
huggingface_hub.login(token="X") 
import torch
from esm.models.esm3 import ESM3
from esm.sdk.api import ESM3InferenceClient, ESMProtein
from Bio import SeqIO
import os
import time
from tqdm import tqdm  # pip install tqdm if you don't have it

# File configurations
fasta_file = "X"
output_dir = "esm3_embeddings_non_heme"  
model_name = "esm3_sm_open_v1"
error_log_file = "failed_sequences.txt"

if torch.cuda.is_available():
    device = torch.device("cuda")
    print(f"Using GPU: {torch.cuda.get_device_name(0)}")
else:
    device = torch.device("cpu")
    print("WARNING: Running on CPU.")

print(f"Loading {model_name} to {device}...")
model: ESM3InferenceClient = ESM3.from_pretrained(model_name).to(device)
model.float() 
model.eval() 

os.makedirs(output_dir, exist_ok=True)

print("Counting sequences...")
total_sequences = sum(1 for _ in SeqIO.parse(fasta_file, "fasta"))
print(f"Found {total_sequences} sequences. Starting run...")

records = SeqIO.parse(fasta_file, "fasta")

for record in tqdm(records, total=total_sequences, unit="seq"):
    header = record.id
    sequence = str(record.seq)
    
    safe_filename = header.replace("|", "_")
    output_path = os.path.join(output_dir, f"{safe_filename}.pt")

    # If file already exists, skip it
    if os.path.exists(output_path):
        continue

    protein = ESMProtein(sequence=sequence)
    
    try:
        with torch.no_grad():
            protein_tensor = model.encode(protein)
            
            sequence_tokens = protein_tensor.sequence.unsqueeze(0).to(device)
            
            output = model.forward(sequence_tokens=sequence_tokens)
            
            embeddings = output.embeddings.squeeze(0).cpu()
            mean_embedding = embeddings.mean(dim=0)

        torch.save({
            "label": header,
            "mean_embedding": mean_embedding,
            "per_residue_embedding": embeddings 
        }, output_path)
        
    except Exception as e:
        # Log errors to a file instead of clogging the console
        error_msg = f"{header}: {str(e)}\n"
        with open(error_log_file, "a") as f:
            f.write(error_msg)

print("-" * 30)
print(f"Done, Check {error_log_file} for any failures.")
