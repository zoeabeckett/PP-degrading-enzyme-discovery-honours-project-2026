def parse_fasta(path):
    header, seqlines = None, []
    with open(path) as fh:
        for line in fh:
            line = line.rstrip()
            if not line or line.startswith(";"):
                continue
            if line.startswith(">"):
                if header is not None:
                    yield header, "".join(seqlines)
                header = line[1:]
                seqlines = []
            else:
                seqlines.append(line)
    if header is not None:
        yield header, "".join(seqlines)


def protein_description(header):
    parts = header.split(None, 1)
    return parts[1] if len(parts) > 1 else parts[0]


def classify(header):
    desc = protein_description(header)
    for rule in RULES:
        if not all(re.search(p, desc, re.IGNORECASE) for p in rule["require"]):
            continue
        if any(re.search(p, desc, re.IGNORECASE) for p in rule.get("exclude", [])):
            continue
        return rule
    return None


def format_file_header(rule):
    return (
        f"; ── Group {rule['id']}: {rule['label']} ──\n"
        f"; Boltz ligand(s): {', '.join(rule['boltz_ligands'])}\n"
        f"; Note: {rule['boltz_note']}\n"
        ";\n"
    )


def write_record(fh, header, seq, width=60):
    fh.write(f">{header}\n")
    for i in range(0, len(seq), width):
        fh.write(seq[i:i+width] + "\n")

# Main 

def main():
    parser = argparse.ArgumentParser(
        description="iron-protein FASTA split by cofactor group for Boltz YAML."
    )
    parser.add_argument("fasta", help="Input multi-sequence FASTA file")
    parser.add_argument("--outdir", default="cofactor_groups")
    parser.add_argument("--verbose", action="store_true",
                        help="Print every classification decision")
    args = parser.parse_args()

    os.makedirs(args.outdir, exist_ok=True)
    sequences = list(parse_fasta(args.fasta))
    print(f"Read {len(sequences)} sequences from {args.fasta}\n")

    buckets = defaultdict(list)
    stem_to_rule = {}
    unclassified = []
    flagged = []

    for header, seq in sequences:
        rule = classify(header)
        if rule is None:
            unclassified.append((header, seq))
            if args.verbose:
                print(f"  [UNCLASSIFIED] {header[:90]}")
        else:
            buckets[rule["stem"]].append((header, seq))
            stem_to_rule[rule["stem"]] = rule
            if rule.get("flag"):
                flagged.append((header, seq, rule["flag_reason"]))
            if args.verbose:
                desc = protein_description(header)[:55]
                print(f"  [G{rule['id']:02d}] {rule['stem']:<42} {desc}")

    seen_stems = sorted(stem_to_rule, key=lambda s: stem_to_rule[s]["id"])
    counts = {}
    for stem in seen_stems:
        rule = stem_to_rule[stem]
        records = buckets[stem]
        outpath = os.path.join(args.outdir, f"{stem}.fasta")
        with open(outpath, "w") as fh:
            fh.write(format_file_header(rule))
            for h, s in records:
                write_record(fh, h, s)
        counts[stem] = len(records)
        print(f"  Wrote {len(records):4d}  →  {stem}.fasta")

    if unclassified:
        outpath = os.path.join(args.outdir, "unclassified.fasta")
        with open(outpath, "w") as fh:
            fh.write(
                "; ── Unclassified sequences ──\n"
                "; No keyword pattern matched the protein description.\n"
                "; Action: check UniProt annotation or run BLAST against\n"
                ";         characterised iron proteins before assigning Boltz cofactors.\n"
                ";\n"
            )
            for h, s in unclassified:
                write_record(fh, h, s)
        print(f"\n  Wrote {len(unclassified):4d}  →  unclassified.fasta")
    else:
        print("\n  All proteins classified — no unclassified.fasta written.")

    # Flagged
    all_flagged = flagged + [
        (h, s, "No cofactor pattern matched — manual review required")
        for h, s in unclassified
    ]
    if all_flagged:
        outpath = os.path.join(args.outdir, "flagged_do_not_assign_fe.fasta")
        with open(outpath, "w") as fh:
            fh.write(
                "; ── FLAGGED: review ──\n"
                "; Contains copper-primary proteins and unclassified sequences.\n"
                "; Reason appended to each header as [FLAG: ...].\n"
                ";\n"
            )
            for h, s, reason in all_flagged:
                write_record(fh, f"{h} [FLAG: {reason}]", s)
        print(f"  Wrote {len(all_flagged):4d}  →  flagged_do_not_assign_fe.fasta")

    # Summary
    total = len(sequences)
    classified = total - len(unclassified)
    print(f"\n{'='*62}")
    print(f"  Total : {total}   Classified : {classified} ({100*classified/total:.1f}%)   Unclassified : {len(unclassified)}")
    print(f"{'─'*62}")
    print(f"  {'Group':<44} {'Ligand(s)':<22} {'N':>4}")
    print(f"  {'─'*43} {'─'*21} {'─'*4}")
    for stem in seen_stems:
        rule = stem_to_rule[stem]
        ligs = ", ".join(rule["boltz_ligands"])
        print(f"  {rule['label'][:43]:<44} {ligs:<22} {counts[stem]:>4}")
    print(f"{'='*62}")
    print(f"\nOutput: {os.path.abspath(args.outdir)}/")


if __name__ == "__main__":
    main()
